//
// Бой теперь ОДИН — зонная механика с постановкой от первого лица, и живёт
// он целиком в ec-battle.lvns (руки, спрайт врага по девяти дистанциям,
// паттерны, зоны, стихии). Этот файл остался только ради старой точки входа
// ec-ch01: battle_fp_skeleton(). Новым главам он не нужен — они включают
// ec-battle.lvns и зовут battle(враг, лимит) напрямую.

include "ec-battle.lvns"

func battle_fp_skeleton() {
  battle("скелет", 4)
  // Пролог не убивает героя: «пал» превращается в «отступил», как и было в
  // старом FP-бою. Единица здоровья нужна следующей реплике главы.
  if бой_итог == "пал" {
    здоровье = 1
    бой_итог = "отступил"
  } else {
  }
}
