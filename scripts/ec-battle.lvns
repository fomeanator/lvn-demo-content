  obj id=fp_enemy sprite_url="/content/sprites/ec_combat_fp/skeleton_idle.png" x=0.5 y=0.52 width=0.39 height=0.58 anchor="0.5,0.5" z=10
  -> ecfp_enemy_done
  :ecfp_idle_d6
  obj id=fp_enemy sprite_url="/content/sprites/ec_combat_fp/skeleton_idle.png" x=0.5 y=0.51 width=0.34 height=0.50 anchor="0.5,0.5" z=10
  -> ecfp_enemy_done
  :ecfp_idle_d7
