// ⚔ ELEMENTAL CHRONICLES — ЗОННЫЙ БОЙ (три зоны, паттерны врагов)
//
// Подключается главой, которой нужен бой:
//     scene ec_ch07
//     include "ec-battle.lvns"        // сам подтянет ec-mechanics.lvns
//
// И вызывается ОДНОЙ строкой:
//     battle("Костолом", 5)
//     if бой_победа == 0 -> оформлен_по_форме
//     -> отбился
//
// ══════════════════════════════════════════════════════════════════════
//  ПРАВИЛА, КОТОРЫЕ ЗДЕСЬ РЕАЛИЗОВАНЫ (решение владельца и Феди)
// ══════════════════════════════════════════════════════════════════════
//
//  ТРИ ЗОНЫ: голова, корпус, ноги.
//
//  ХОД ИГРОКА — ДВА выбора по ТРИ опции: сначала «куда бью», потом «что
//  закрываю». Именно два выбора, а не один список из девяти комбинаций:
//  девять пунктов забракованы прямым текстом. В скомпилированном .lvn это
//  два отдельных `choice` по три опции — их разделяет строка-подсказка
//  («Что закрываешь?»), и она же показывается ВМЕСТЕ с опциями, без лишнего
//  клика (рантайм спаривает say + choice).
//
//  У КАЖДОГО ВРАГА СВОЙ ПАТТЕРН. НИКАКОГО РАНДОМА. rand() в этом файле нет
//  ни одного — ни в выборе действий врага, ни в уклонении, ни в побеге.
//  Со случайным врагом защита это угадывание один к трём, и умения не
//  существует; с паттерном игрок УЧИТСЯ (модель Punch-Out!!).
//
//  ПАТТЕРН — ТАБЛИЦА: новый враг это ОДНА строка в `паттерн`. Ход паттерна =
//  list(куда бьёт, что закрывает, тычок, сила удара в процентах).
//    · пустая зона удара ("") — этот ход враг НЕ БЬЁТ (замах, подзарядка);
//    · пустая зона защиты ("") — он НЕ ЗАКРЫВАЕТСЯ вовсе (окно для игрока);
//    · четвёртое поле можно не писать — тогда 100.
//  Схватка длиннее паттерна — паттерн повторяется с начала.
//
//  ТЫЧОК (tell) показывается ПЕРЕД выбором игрока и привязан к шагу
//  паттерна: паттерн выучиваем с первого боя, мастерство — это память о нём.
//  Без тычка первый бой с новым врагом был бы слепым угадыванием.
//
//  РАЗРЕШЕНИЕ ХОДА. Мой удар попал, если моя зона удара НЕ совпала с зоной,
//  которую враг закрывает этот ход. Удар врага попал, если его зона удара НЕ
//  совпала с моей зоной защиты. Оба удара разрешаются в одном ходу: могут
//  попасть оба, ни один, или один.
//
//  КАМЕНЬ-НОЖНИЦЫ-БУМАГА между зонами УДАРА, когда попали ОБА: голова бьёт
//  ноги, ноги бьют корпус, корпус бьёт голову. Выигравший в тройке бьёт на
//  +50%, проигравший на -30% (таблица `зона_вес`). Ради этого зоны и
//  вводились: выбор зоны значит что-то сам, а не только как угадывание.
//
//  ЭФФЕКТЫ ЗОН при попадании — В ОБЕ СТОРОНЫ (и по врагу, и по игроку):
//    ГОЛОВА — оглушение, пропуск следующего хода;
//    НОГИ   — не сможет убежать и теряет уклонение;
//    КОРПУС — самый высокий базовый урон, без эффекта.
//
//  СТИХИИ ПОВЕРХ ЗОН: урон считается через готовые hit()/foedmg()/
//  advantage()/elpow() из ec-mechanics.lvns, а не заново. Стихия выбирается
//  автоматически — лучшая из выученных против этого врага (иначе «кулак»),
//  чтобы у игрока по-прежнему было ДВА выбора, а не три.
//
//  ДЛИНА СХВАТКИ 4–6 ходов: второй аргумент battle() зажимается в 4..6.
//  Никто не умер за лимит — итог решается по состоянию (у кого процент
//  здоровья ниже, тот и разрывает дистанцию).
//
//  ПРОИГРЫШ — НЕ ЗАГРУЗКА СЕЙВА, а поворот сюжета: процедура возвращается
//  в главу, и глава идёт другой веткой. Ни save, ни load здесь нет.
//
// ══════════════════════════════════════════════════════════════════════
//  ЧТО ПРОЦЕДУРА ОТДАЁТ ОБРАТНО В ГЛАВУ
// ══════════════════════════════════════════════════════════════════════
//   бой_победа      1 — выиграл, 0 — нет. Ветвиться проще всего по нему.
//   бой_итог        "убил" | "прогнал" | "выстоял" | "пал" | "отступил"
//   бой_ноги_мои    1 — ноги перебиты, уйти ты не можешь (ветка плена)
//   бой_ноги_врага  1 — перебиты ему (он не убежал и не убежит)
//   бой_ход         сколько ходов заняла схватка
//   бой_хп          сколько здоровья осталось врагу
//   бой_стихия      чем ты дрался
// Награда (опыт, кристалл, победы/поражения, уровень) начисляется ВНУТРИ —
// главе не надо помнить про reward()/drop(), иначе это опять копипаста.
//
// Необязательный вход, ставится ПЕРЕД вызовом:
//   бой_фора = 12    // вычесть из стартового здоровья врага (урон_тирану и т.п.)
// Фора сбрасывается в 0 после боя, чтобы не протекла в следующую схватку.
//
// ⚠ ФОН СТАВИТ ГЛАВА, а не бой: sprite_url у команды `bg` в рантайме НЕ
// интерполируется ({бой_фон} уехал бы в загрузчик как есть). Так что перед
// вызовом просто напиши `desert` или свой `bg` — это одна строка постановки.

include "ec-mechanics.lvns"

// ══════════════════════════════════════════════════════════════════════
//  0. ПОСТАНОВКА ОТ ПЕРВОГО ЛИЦА (слита из ec-battle-fp.lvns)
// ══════════════════════════════════════════════════════════════════════
// Бой теперь ОДИН: зонная механика + камера-глаза. Герой существует как
// руки с мечом, враг — спрайт, растущий с сокращением дистанции. Дистанция
// из механики стала постановкой: она дышит характером хода (замах — враг
// отходит и копит, атака — надвигается), но НЕ добавляет третьего выбора —
// канон «два выбора по три опции» не тронут.
//
// ⚠ СПРАЙТЫ ПОКА СКЕЛЕТНЫЕ ДЛЯ ВСЕХ (решение владельца: «спрайты потом
// будут»). Когда появится арт врага — добавляется свой набор поз в
// ecfp_enemy по образцу скелета, механику трогать не нужно.

// ─── 0.1. Боевая дистанция — характер врага, одна строка на врага ─────
// С какой дистанции враг ведёт бой: паук липнет вплотную, некромант и
// тиран держатся подальше, червь вообще из-под земли. Дефолт 4.
враг_даль = {}
враг_даль = put(враг_даль, "скелет", 4)
враг_даль = put(враг_даль, "дрон", 5)
враг_даль = put(враг_даль, "Ржавый", 4)
враг_даль = put(враг_даль, "Костолом", 3)
враг_даль = put(враг_даль, "матёрый скелет", 4)
враг_даль = put(враг_даль, "глитч", 3)
враг_даль = put(враг_даль, "некромант", 6)
враг_даль = put(враг_даль, "кристальный паук", 2)
враг_даль = put(враг_даль, "песчаный червь", 7)
враг_даль = put(враг_даль, "меха-полковник", 5)
враг_даль = put(враг_даль, "ледяной великан", 6)
враг_даль = put(враг_даль, "страж огня", 5)
враг_даль = put(враг_даль, "страж воды", 5)
враг_даль = put(враг_даль, "страж земли", 5)
враг_даль = put(враг_даль, "страж ветра", 5)
враг_даль = put(враг_даль, "звёздный тиран", 7)
враг_даль = put(враг_даль, "Нихарис", 3)

func fdist(f) { return get(враг_даль, f, 4) }

// ─── 0.1a. Радиус удара — с какой дистанции враг ДОСТАЁТ ─────────────
// Ближник (радиус 2) обязан дойти до тебя — и идёт, честно, не сдвигая
// паттерн. Дальнобойный (9) бьёт с места, к нему идёшь сам под обстрелом.
// Твой меч достаёт с 2. Дефолт 2 — ближники.
враг_радиус = {}
враг_радиус = put(враг_радиус, "дрон", 9)
враг_радиус = put(враг_радиус, "некромант", 9)
враг_радиус = put(враг_радиус, "песчаный червь", 9)
враг_радиус = put(враг_радиус, "меха-полковник", 9)
враг_радиус = put(враг_радиус, "ледяной великан", 3)
враг_радиус = put(враг_радиус, "страж огня", 9)
враг_радиус = put(враг_радиус, "страж воды", 9)
враг_радиус = put(враг_радиус, "страж земли", 9)
враг_радиус = put(враг_радиус, "страж ветра", 9)
враг_радиус = put(враг_радиус, "звёздный тиран", 9)
враг_радиус = put(враг_радиус, "Нихарис", 3)

func frange(f) { return get(враг_радиус, f, 2) }

// ─── 0.1b. Особенности врагов из бестиария (данные, не код) ──────────
// вамп: процент нанесённого ТЕБЕ урона, который враг лечит себе.
// кислота: его попадание растворяет броню (−1 за удар, до нуля).
// шипы: процент ТВОЕГО урона, который возвращается тебе (отражение).
враг_вамп = {}
враг_кислота = {}
враг_шипы = {}
func fvamp(f) { return get(враг_вамп, f, 0) }
func facid(f) { return get(враг_кислота, f, 0) }
func fspikes(f) { return get(враг_шипы, f, 0) }

// ─── 0.2. Спрайт врага: поза × девять дистанций ──────────────────────
// Числовые поля obj не принимают выражения, поэтому девять явных размеров —
// по одному на клетку. На distance=1 нижняя половина противника намеренно
// уходит за экран: это уже не фигурка, а враг в метре.
func ecfp_enemy(pose) {
  if pose == "attack" -> ecfp_enemy_attack
  if pose == "hurt" -> ecfp_enemy_hurt
  -> ecfp_enemy_idle

  :ecfp_enemy_attack
  if fp_distance <= 1 -> ecfp_attack_d1
  if fp_distance <= 2 -> ecfp_attack_d2
  if fp_distance <= 3 -> ecfp_attack_d3
  if fp_distance <= 4 -> ecfp_attack_d4
  if fp_distance <= 5 -> ecfp_attack_d5
  if fp_distance <= 6 -> ecfp_attack_d6
  if fp_distance <= 7 -> ecfp_attack_d7
  if fp_distance <= 8 -> ecfp_attack_d8
  -> ecfp_attack_d9
  :ecfp_attack_d1
  obj id=fp_enemy sprite_url="/content/sprites/ec_combat_fp/skeleton_attack.png" x=0.5 y=0.56 width=1.44 height=2.10 anchor="0.5,0.5" z=10
  -> ecfp_enemy_done
  :ecfp_attack_d2
  obj id=fp_enemy sprite_url="/content/sprites/ec_combat_fp/skeleton_attack.png" x=0.5 y=0.56 width=0.72 height=1.05 anchor="0.5,0.5" z=10
  -> ecfp_enemy_done
  :ecfp_attack_d3
  obj id=fp_enemy sprite_url="/content/sprites/ec_combat_fp/skeleton_attack.png" x=0.5 y=0.54 width=0.56 height=0.82 anchor="0.5,0.5" z=10
  -> ecfp_enemy_done
  :ecfp_attack_d4
  obj id=fp_enemy sprite_url="/content/sprites/ec_combat_fp/skeleton_attack.png" x=0.5 y=0.53 width=0.46 height=0.68 anchor="0.5,0.5" z=10
  -> ecfp_enemy_done
  :ecfp_attack_d5
  obj id=fp_enemy sprite_url="/content/sprites/ec_combat_fp/skeleton_attack.png" x=0.5 y=0.52 width=0.39 height=0.58 anchor="0.5,0.5" z=10
  -> ecfp_enemy_done
  :ecfp_attack_d6
  obj id=fp_enemy sprite_url="/content/sprites/ec_combat_fp/skeleton_attack.png" x=0.5 y=0.51 width=0.34 height=0.50 anchor="0.5,0.5" z=10
  -> ecfp_enemy_done
  :ecfp_attack_d7
  obj id=fp_enemy sprite_url="/content/sprites/ec_combat_fp/skeleton_attack.png" x=0.5 y=0.50 width=0.29 height=0.43 anchor="0.5,0.5" z=10
  -> ecfp_enemy_done
  :ecfp_attack_d8
  obj id=fp_enemy sprite_url="/content/sprites/ec_combat_fp/skeleton_attack.png" x=0.5 y=0.50 width=0.25 height=0.37 anchor="0.5,0.5" z=10
  -> ecfp_enemy_done
  :ecfp_attack_d9
  obj id=fp_enemy sprite_url="/content/sprites/ec_combat_fp/skeleton_attack.png" x=0.5 y=0.50 width=0.22 height=0.32 anchor="0.5,0.5" z=10
  -> ecfp_enemy_done

  :ecfp_enemy_hurt
  if fp_distance <= 1 -> ecfp_hurt_d1
  if fp_distance <= 2 -> ecfp_hurt_d2
  if fp_distance <= 3 -> ecfp_hurt_d3
  if fp_distance <= 4 -> ecfp_hurt_d4
  if fp_distance <= 5 -> ecfp_hurt_d5
  if fp_distance <= 6 -> ecfp_hurt_d6
  if fp_distance <= 7 -> ecfp_hurt_d7
  if fp_distance <= 8 -> ecfp_hurt_d8
  -> ecfp_hurt_d9
  :ecfp_hurt_d1
  obj id=fp_enemy sprite_url="/content/sprites/ec_combat_fp/skeleton_hurt.png" x=0.5 y=0.56 width=1.44 height=2.10 anchor="0.5,0.5" z=10
  -> ecfp_enemy_done
  :ecfp_hurt_d2
  obj id=fp_enemy sprite_url="/content/sprites/ec_combat_fp/skeleton_hurt.png" x=0.5 y=0.56 width=0.72 height=1.05 anchor="0.5,0.5" z=10
  -> ecfp_enemy_done
  :ecfp_hurt_d3
  obj id=fp_enemy sprite_url="/content/sprites/ec_combat_fp/skeleton_hurt.png" x=0.5 y=0.54 width=0.56 height=0.82 anchor="0.5,0.5" z=10
  -> ecfp_enemy_done
  :ecfp_hurt_d4
  obj id=fp_enemy sprite_url="/content/sprites/ec_combat_fp/skeleton_hurt.png" x=0.5 y=0.53 width=0.46 height=0.68 anchor="0.5,0.5" z=10
  -> ecfp_enemy_done
  :ecfp_hurt_d5
  obj id=fp_enemy sprite_url="/content/sprites/ec_combat_fp/skeleton_hurt.png" x=0.5 y=0.52 width=0.39 height=0.58 anchor="0.5,0.5" z=10
  -> ecfp_enemy_done
  :ecfp_hurt_d6
  obj id=fp_enemy sprite_url="/content/sprites/ec_combat_fp/skeleton_hurt.png" x=0.5 y=0.51 width=0.34 height=0.50 anchor="0.5,0.5" z=10
  -> ecfp_enemy_done
  :ecfp_hurt_d7
  obj id=fp_enemy sprite_url="/content/sprites/ec_combat_fp/skeleton_hurt.png" x=0.5 y=0.50 width=0.29 height=0.43 anchor="0.5,0.5" z=10
  -> ecfp_enemy_done
  :ecfp_hurt_d8
  obj id=fp_enemy sprite_url="/content/sprites/ec_combat_fp/skeleton_hurt.png" x=0.5 y=0.50 width=0.25 height=0.37 anchor="0.5,0.5" z=10
  -> ecfp_enemy_done
  :ecfp_hurt_d9
  obj id=fp_enemy sprite_url="/content/sprites/ec_combat_fp/skeleton_hurt.png" x=0.5 y=0.50 width=0.22 height=0.32 anchor="0.5,0.5" z=10
  -> ecfp_enemy_done

  :ecfp_enemy_idle
  if fp_distance <= 1 -> ecfp_idle_d1
  if fp_distance <= 2 -> ecfp_idle_d2
  if fp_distance <= 3 -> ecfp_idle_d3
  if fp_distance <= 4 -> ecfp_idle_d4
  if fp_distance <= 5 -> ecfp_idle_d5
  if fp_distance <= 6 -> ecfp_idle_d6
  if fp_distance <= 7 -> ecfp_idle_d7
  if fp_distance <= 8 -> ecfp_idle_d8
  -> ecfp_idle_d9
  :ecfp_idle_d1
  obj id=fp_enemy sprite_url="/content/sprites/ec_combat_fp/skeleton_idle.png" x=0.5 y=0.56 width=1.44 height=2.10 anchor="0.5,0.5" z=10
  -> ecfp_enemy_done
