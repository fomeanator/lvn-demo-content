scene ec_prologue

// ⚡ ELEMENTAL CHRONICLES — Пролог: Пробуждение в Эфирии
// По документу Феди и Саши (версия 4.0.3, статус ГОТОВ К РЕАЛИЗАЦИИ).
//
// Состояние, таблицы стихий, функции и пресеты — в общем файле, который
// подключают ВСЕ главы. Правка таблицы там меняет игру целиком.
//
// Новый модуль first-person подключает общие механики EC. Остальные главы
// продолжают пользоваться прежним ec-battle.lvns независимо от пролога.
// Только первая схватка показывается глазами героя: в ней его обычный спрайт
// скрывается, а после боя возвращается в новеллу.
include "ec-battle-fp.lvns"
include "ec-preload.lvns"

// Всё, что понадобится в первой схватке, грузим до первой реплики, чтобы
// при смене фона, позы или боевой кнопки кадр не мигал пустым.
preload url="/content/bg/ec/spirit_forest.jpg" kind=sprite
preload url="/content/bg/ec/road_north.jpg" kind=sprite
preload url="/content/bg/ec/efiria.jpg" kind=sprite
preload url="/content/sprites/ec_combat_fp/skeleton_idle.png" kind=sprite
preload url="/content/sprites/ec_combat_fp/skeleton_attack.png" kind=sprite
preload url="/content/sprites/ec_combat_fp/skeleton_hurt.png" kind=sprite
preload url="/content/sprites/ec_combat_fp/hands_sword_idle.png?v=tight2" kind=sprite
preload url="/content/sprites/ec_combat_fp/hands_sword_attack.png" kind=sprite
preload url="/content/sprites/ec_combat_fp/hands_sword_block.png" kind=sprite
preload url="/content/sprites/ec_combat_ui/action_attack.png" kind=sprite
preload url="/content/sprites/ec_combat_ui/action_block.png" kind=sprite
preload url="/content/sprites/ec_combat_ui/action_forward.png" kind=sprite
preload url="/content/sprites/ec_combat_ui/action_back.png" kind=sprite
preload url="/content/sprites/ec_cast_v2/niharis.png" kind=sprite
preload url="/content/sprites/ec_cast_v2/druid.png" kind=sprite
preload url="/content/sprites/ec_cast_v2/techno.png" kind=sprite
preload url="/content/sprites/ec_cast_v2/necromancer.png" kind=sprite
preload url="/content/sprites/ec_cast_v2/cyberguard.png" kind=sprite
preload url="/content/sprites/ec_cast_v2/spirit.png" kind=sprite
preload url="/content/sprites/ec_cast_v2/tyrant.png" kind=sprite
preload url="/content/sprites/ec_hero_v2/body_traveler.png" kind=sprite
preload url="/content/sprites/ec_hero_v2/face_neutral.png" kind=sprite
preload url="/content/sprites/ec_hero_v2/weapon_sword.png" kind=sprite

m_hope   // деревня и пробуждение
// Счётчик кристаллов показываем через gemsall() (настоящий инвентарь `сумка`),
// а не через устаревшее поле `кристаллы`. Раньше это было неважно: пролог
// кристаллов не выдавал вовсе. Теперь за победу над скелетом падает кристалл
// тьмы — и с прежним счётчиком бой писал «упал кристалл», а полоска честно
// показывала ноль. Поле `кристаллы` живо, его считает глава 2, но пролог его
// не трогает и показывать ему нечего.
hud «⚡ репутация {репутация}   стихий {len(стихии)}   кристаллов {gemsall()}»

bg /content/bg/ec/spirit_forest.jpg
actor ec_hero left neutral outfit=traveler weapon=sword flip=true
«Ты приходишь в себя на окраине деревни. Небо цвета остывающего железа,
и по холму со стороны леса спускаются они — белые, костяные, молчаливые.»

input var=имя prompt="Как тебя зовут?" default="Странник" max=20

{имя}: Где я? И почему у меня в руке чужой меч?

niharis raised angry
Нихарис: Ты в Эфирии. Я — Нихарис, и обычно люди видят меня один раз.
Нихарис: Но у тебя, {имя}, ещё есть дело. Деревню сейчас съедят.

- Броситься на скелетов -> бой
- Увести жителей в лес -> увести
- Спросить, что ей с этого -> спросить

:спросить
Нихарис [smile]: Честный вопрос. Мне скучно, а ты забавный.
репутация = репутация + 1
Нихарис: Иди уже. Времени — на один вдох.
- Броситься на скелетов -> бой
- Увести жителей в лес -> увести

:бой
niharis hide
actor ec_hero hide
bg /content/bg/ec/road_north.jpg
camera action=shake amplitude=0.04 duration=0.5
flash color="#ff3b30" duration=0.25
«Меч оказался тяжелее, чем выглядел. Ты успел встать между костями и
крайним домом — этого хватило, чтобы люди убежали.»

// ⚠ НАГРАДА ЗА ПОСТУПОК СТОИТ ДО СХВАТКИ И НЕ ЗАВИСИТ ОТ ЕЁ ИСХОДА.
// Жители убежали, пока ты стоял в проходе, — это уже случилось. Поэтому +3
// репутации и +1 Эфирии начисляются ЗДЕСЬ, а не в ветках победы/поражения:
// пролог отдаёт дальше ровно те же числа, что и до зонного боя, и порог
// концовки (`репутация >= 8`) не сдвинулся ни на единицу.
репутация = репутация + 3
эфирия = эфирия + 1

«Тропа к дому узкая, и это единственное, что сейчас на твоей стороне. Первый
скелет выходит на тебя один, остальные ждут за ним — им просто негде встать
рядом. Меч ты держишь как палку, потому что стихий пока не знаешь и всё, что
у тебя есть, это вес железа и кулак.»

// ЕДИНЫЙ БОЙ: зонная механика с постановкой от первого лица. Герой — камера
// и руки с мечом, скелет надвигается и отходит по характеру своего хода.
// Два выбора за ход (куда бью / что закрываю), паттерн врага без рандома.
text hud hide
battle_fp_skeleton()
// Герой НЕ встаёт в кадр после боя: сцена — Нихарис над костями;
// «камера-герой» возвращается телом в :утро.
hud «⚡ репутация {репутация}   стихий {len(стихии)}   кристаллов {gemsall()}»
if бой_победа == 0 -> бой_не_вышло
-> бой_вышло

:бой_вышло
skeleton hide
niharis raised calm
Нихарис: Глупо и громко. Мне понравилось.
if бой_ноги_врага == 1 {
  Нихарис: И по коленям ты его первым делом. Практично. Он ведь и правда никуда не ушёл.
} else {
}
-> утро

:бой_не_вышло
skeleton hide
niharis raised calm
// Проиграть здесь — НЕ загрузка сейва. Деревня всё равно пуста, и кости
// уходят туда, где ещё есть кого разбирать. Умереть в прологе нельзя: если
// зонный бой доводит до «пал», шим battle_fp_skeleton() превращает это в
// «отступил» и оставляет единицу здоровья (см. ec-battle-fp.lvns).
«Ты не свалил его. Он отходит к своим — не потому, что испугался, а потому,
что в деревне больше некого искать, а ты стоишь и мешаешь.»
// ⚠ Внутри блока наррацию пишем ОДНОЙ строкой: перенос сохранил бы отступ
// блока, и в игре вторая строка поехала бы на два пробела вправо.
if бой_ноги_мои == 1 {
  «Нога не держит. Ты садишься там же, где стоял, и смотришь, как они уходят вверх по холму — ровным строем, будто у них смена кончилась.»
} else {
}
Нихарис: Громко и без толку. Мне, впрочем, тоже понравилось.
-> утро

:увести
niharis hide
«Ты не стал драться. Ты стучал в двери, орал, тащил за руки — и вывел в лес
всех, включая старуху, которая до последнего собирала горшки.»
репутация = репутация + 3
техногард = техногард + 1
Нихарис: Скучно. Зато никто не умер. Засчитано.
-> утро

:утро
fade to="black" duration=0.8
// Нихарис из ночной сцены и герой боя не переезжают в утро сами — прячем
// ВСЕХ на затемнении, сцена собирается заново («герои не скрываются» — баг).
niharis hide
skeleton hide
obj id=fp_enemy show=false   // кости побеждённого не переезжают в утро
bg /content/bg/ec/efiria.jpg
fade to="clear" duration=0.8
actor ec_hero center neutral outfit=traveler weapon=sword flip=true
«Утро. Холмы Эфирии зелены так, будто ночью ничего не было.»

// Ночь лечит. Это не поблажка, а контракт с главой 2: до зонного боя пролог
// вообще не трогал здоровье, и в Техногард герой приходил на полных двадцати.
// Без этой строки проигравший скелету входил бы в катакомбы избитым и падал
// там на дроне — глава 2 таких проверок не делает и делать не должна.
rest

// ─── Выбор фракции ────────────────────────────────────────────────────
druid calm
techno calm
Друид Эфирии: Ты дрался за живых. Идём к нам — научим слушать лес.
Техник Техногарда: Или к нам. Лес не чинится, а протез — чинится.

- Пойти в Эфирию -> путь_эфирии
- Пойти в Техногард -> путь_техногарда
- Остаться сам по себе -> путь_один expr="репутация >= 4"

:путь_эфирии
фракция = "Эфирия"
эфирия = эфирия + 3
techno hide
Друид Эфирии [smile]: Хороший выбор. Первая стихия — твоя.
стихии = push(стихии, "земля")
-> храм

:путь_техногарда
фракция = "Техногард"
техногард = техногард + 3
druid hide
Техник Техногарда [smile]: Разумно. Держи стартовый контур.
стихии = push(стихии, "молния")
-> храм

:путь_один
фракция = "Никто"
репутация = репутация + 2
druid hide
techno hide
«Ты ушёл один. Обе фракции запомнили это — каждая по-своему.»
стихии = push(стихии, "ветер")
-> храм

// ─── Храм Огня ────────────────────────────────────────────────────────
:храм
fade to="black" duration=0.6
druid hide
techno hide
bg /content/bg/ec/temple_fire.jpg
fade to="clear" duration=0.6
actor ec_hero center neutral outfit=traveler weapon=sword flip=true
«Храм Огня. Жар стоит стеной, а в центре зала горит то, что огнём только
притворяется.»

- Взять огонь -> взять_огонь
- Сначала осмотреться -> осмотреться

:осмотреться
«На стенах — 512 сочетаний, высеченных кем-то очень терпеливым.»
репутация = репутация + 1
- Взять огонь -> взять_огонь

:взять_огонь
стихии = push(стихии, "огонь")
camera action=zoom factor=1.15 duration=0.6
flash color="white" duration=0.3
«Огонь узнал тебя. Теперь у тебя {len(стихии)} стихии.»
-> комбинация

// ─── Комбинации стихий ────────────────────────────────────────────────
:комбинация
bg /content/bg/ec/shining_zone.jpg
«Сияющая зона. Здесь стихии соединяются — если знать, что с чем.»

// Таблица сочетаний: две стихии дают третью. Данные, а не код.
рецепты = {}
рецепты = put(рецепты, "огонь+земля", "магма")
рецепты = put(рецепты, "огонь+молния", "плазма")
рецепты = put(рецепты, "огонь+ветер", "буря пепла")

первая = get(стихии, 0)
ключ = "огонь+" + первая
итог = get(рецепты, ключ, "ничего")

if итог == "ничего" -> провал_комбо
// Именительный падеж — «огонь и земля сходятся», а не «свёл огонь и земля».
// Подстановка {первая} склоняться не умеет, поэтому фраза построена так, чтобы
// склонение и не требовалось. Тот же приём, что `зона_вин` в зонном бою.
«Огонь и {первая} сходятся — получается {итог}. Мощь связки — {power("огонь", первая)}.»
репутация = репутация + 2
стихии = push(стихии, итог)
-> финал

:провал_комбо
«Стихии зашипели и разошлись. Не всякая пара сходится.»
-> финал

// ─── Концовки ─────────────────────────────────────────────────────────
:финал
fade to="black" duration=1.0
bg /content/bg/ec/efiria.jpg
fade to="clear" duration=1.0
actor ec_hero left neutral outfit=traveler weapon=sword flip=true
niharis calm
Нихарис: Ну что, {имя}. Посмотрим, кем ты вышел.

if репутация >= 8 -> концовка_герой
if эфирия > техногард -> концовка_лес
-> концовка_сталь

:концовка_герой
Нихарис [smile]: Восемь и выше. Тебя запомнят обе стороны — редкий случай.
«КОНЦОВКА — ЗВЁЗДНЫЙ ПУТЬ. Репутация {репутация}, стихий {len(стихии)}.»
-> титры

:концовка_лес
Нихарис: Лес принял тебя. Техногард будет считать это ошибкой.
«КОНЦОВКА — КОРНИ. Репутация {репутация}, фракция {фракция}.»
-> титры

:концовка_сталь
Нихарис: Сталь надёжнее корней. Проверим на Акте 3.
«КОНЦОВКА — КОНТУР. Репутация {репутация}, фракция {фракция}.»
-> титры

:титры
text hud hide
obj id=btn_inv_open show=false
clear
«Elemental Chronicles 3.0 — пролог.
Придумали Федя и Саша. Собрано на движке Elvin.
Акты 1–4, мехи и воксели — в следующей версии.»
-> __end
