    {
      "id": "__then_дрон_готов_2",
      "op": "label"
    },
    {
      "op": "say",
      "text": "Четвёртой ноги у него нет давно, а теперь нет и третьей."
    },
    {
      "label": "__end_дрон_готов_2",
      "op": "goto"
    },
    {
      "id": "__else_дрон_готов_2",
      "op": "label"
    },
    {
      "id": "__end_дрон_готов_2",
