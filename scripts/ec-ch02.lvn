    {
      "label": "выход_один",
      "op": "goto"
    },
    {
      "id": "выход_с_кнопкой",
      "op": "label"
    },
    {
      "op": "say",
      "text": "Я иду. Мне холод не страшен, я весь дырявый.",
      "who": "Кнопка"
    },
    {
      "emotion": "smile",
      "id": "ec_niharis",
      "op": "actor"
    },
    {
