    },
    {
      "expr": "победы + 1",
      "key": "победы",
      "op": "set"
    },
    {
      "expr": "(1 + (min(floor(опыт / max(get(пороги, 0, 99999), 1)), 1)) + (min(floor(опыт / max(get(пороги, 1, 99999), 1)), 1)) + (min(floor(опыт / max(get(пороги, 2, 99999), 1)), 1)) + (min(floor(опыт / max(get(пороги, 3, 99999), 1)), 1)) + (min(floor(опыт / max(get(пороги, 4, 99999), 1)), 1)) + (min(floor(опыт / max(get(пороги, 5, 99999), 1)), 1)))",
      "key": "бой_ранее",
      "op": "set"
    },
    {
      "expr": "опыт + (floor((get(враг_хп, бой_враг, 10)) / 8) + get(враг_урон, бой_враг, 3))",
      "key": "опыт",
      "op": "set"
    },
    {
      "expr": "(put(сумка, (get(враг_стихия, бой_враг, \"земля\")), (get(сумка, (get(враг_стихия, бой_враг, \"земля\")), 0)) + 1))",
      "key": "сумка",
      "op": "set"
    },
    {
      "op": "say",
      "text": "Опыта {(floor((get(враг_хп, бой_враг, 10)) / 8) + get(враг_урон, бой_враг, 3))}, и с него упал кристалл {(get(враг_стихия, бой_враг, \"земля\"))}."
    },
    {
      "else": "__else_head_47",
      "expr": "(1 + (min(floor(опыт / max(get(пороги, 0, 99999), 1)), 1)) + (min(floor(опыт / max(get(пороги, 1, 99999), 1)), 1)) + (min(floor(опыт / max(get(пороги, 2, 99999), 1)), 1)) + (min(floor(опыт / max(get(пороги, 3, 99999), 1)), 1)) + (min(floor(опыт / max(get(пороги, 4, 99999), 1)), 1)) + (min(floor(опыт / max(get(пороги, 5, 99999), 1)), 1))) \u003e бой_ранее",
      "op": "if",
      "then": "__then_head_47"
    },
    {
      "id": "__then_head_47",
      "op": "label"
    },
    {
      "duration": 3,
      "op": "hint",
      "text": "⬆ Новый уровень: {(1 + (min(floor(опыт / max(get(пороги, 0, 99999), 1)), 1)) + (min(floor(опыт / max(get(пороги, 1, 99999), 1)), 1)) + (min(floor(опыт / max(get(пороги, 2, 99999), 1)), 1)) + (min(floor(опыт / max(get(пороги, 3, 99999), 1)), 1)) + (min(floor(опыт / max(get(пороги, 4, 99999), 1)), 1)) + (min(floor(опыт / max(get(пороги, 5, 99999), 1)), 1)))} — {(get(титулы, (1 + (min(floor(опыт / max(get(пороги, 0, 99999), 1)), 1)) + (min(floor(опыт / max(get(пороги, 1, 99999), 1)), 1)) + (min(floor(опыт / max(get(пороги, 2, 99999), 1)), 1)) + (min(floor(опыт / max(get(пороги, 3, 99999), 1)), 1)) + (min(floor(опыт / max(get(пороги, 4, 99999), 1)), 1)) + (min(floor(опыт / max(get(пороги, 5, 99999), 1)), 1))) - 1, \"Легенда\"))}"
    },
