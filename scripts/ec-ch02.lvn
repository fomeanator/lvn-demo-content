    {
      "expr": "{}",
      "key": "паттерн",
      "op": "set"
    },
    {
      "expr": "put(паттерн, \"скелет\", list(list(\"голова\", \"голова\", \"Костяная рука идёт к твоему лицу, вторая прикрывает череп.\"), list(\"ноги\", \"ноги\", \"Он приседает и метит в колено, прикрывая голени.\")))",
      "key": "паттерн",
      "op": "set"
    },
    {
      "expr": "put(паттерн, \"дрон\", list(list(\"корпус\", \"голова\", \"Дрон разворачивает разрядник на твою грудь и прячет камеру под кожух.\"), list(\"ноги\", \"корпус\", \"Он проседает к земле, целит в стопы и подставляет броневую пластину на боку.\")))",
      "key": "паттерн",
      "op": "set"
    },
    {
      "expr": "put(паттерн, \"Ржавый\", list(list(\"корпус\", \"голова\", \"Пи. Манипулятор заводится назад для прямого в корпус, свободная лапа закрывает решётку динамика на голове.\"), list(\"\", \"\", \"Пи. Заряд четыре процента. Он замирает и гудит на подзарядке — этот ход он не бьёт и не закрывает ничего.\")))",
      "key": "паттерн",
      "op": "set"
    },
    {
      "expr": "put(паттерн, \"Костолом\", list(list(\"голова\", \"корпус\", \"Костолом держит папку у груди и постукивает пальцем по верхней графе.\"), list(\"корпус\", \"корпус\", \"Он перелистывает на второй лист. Папка по-прежнему у груди.\"), list(\"ноги\", \"корпус\", \"Третий лист. Печать ставится у нижнего края, и он смотрит тебе на ноги. Папка у груди.\")))",
      "key": "паттерн",
      "op": "set"
    },
    {
      "expr": "put(паттерн, \"матёрый скелет\", list(list(\"корпус\", \"голова\", \"Он бьёт снизу под рёбра, а череп уводит за плечо.\"), list(\"голова\", \"ноги\", \"Замах идёт сверху, к твоему лицу, а голени он подбирает под себя.\"), list(\"ноги\", \"корпус\", \"Он метит в колено и прикрывает грудь предплечьем.\")))",
      "key": "паттерн",
      "op": "set"
    },
    {
      "expr": "put(паттерн, \"некромант\", list(list(\"голова\", \"голова\", \"Некромант тычет пальцем тебе в лоб и прячет лицо в капюшон.\"), list(\"\", \"голова\", \"Он читает по свитку и не бьёт — только держит капюшон, чтобы не сдуло.\"), list(\"корпус\", \"\", \"Обе руки уходят вверх с проклятием. Он открыт целиком, но ударит в грудь тяжело.\", 150)))",
      "key": "паттерн",
      "op": "set"
    },
    {
      "expr": "put(паттерн, \"кристальный паук\", list(list(\"ноги\", \"корпус\", \"Паук стрижёт кромкой по земле, к твоим ногам, и подбирает брюшко.\"), list(\"ноги\", \"голова\", \"Ещё раз по ногам. Головогрудь он прячет за хелицерами.\"), list(\"голова\", \"корпус\", \"Он подгибает лапы для прыжка. Ударит сверху, по голове, и тяжело; брюшко прижато.\", 150)))",
      "key": "паттерн",
      "op": "set"
    },
    {
      "expr": "put(паттерн, \"песчаный червь\", list(list(\"\", \"корпус\", \"Червь уходит в песок целиком. Этот ход он не бьёт, и туловище его не достать.\"), list(\"корпус\", \"\", \"Песок вспухает горбом. Он выйдет снизу всей массой, в грудь, и в этот миг открыт весь.\", 200)))",
      "key": "паттерн",
      "op": "set"
    },
    {
      "expr": "put(паттерн, \"ледяной великан\", list(list(\"голова\", \"ноги\", \"Кулак уходит вверх, к твоей голове, а ступни он вмораживает в наст.\"), list(\"ноги\", \"голова\", \"Он размахивается по земле, по твоим ногам, и вжимает голову в плечи.\"), list(\"корпус\", \"корпус\", \"Великан наваливается грудью вперёд. Тяжело, и грудь же закрыта наростом льда.\", 150)))",
      "key": "паттерн",
      "op": "set"
    },
    {
      "expr": "put(паттерн, \"глитч\", list(list(\"голова\", \"ноги\", \"Глитч мигает. Рука уже у твоего лица, а ноги дублируются в четыре копии — не разберёшь, какие настоящие.\"), list(\"голова\", \"корпус\", \"Кадр залип. Та же рука идёт к лицу второй раз, а корпус закрыт копией, наехавшей на настоящий.\"), list(\"ноги\", \"голова\", \"Копии рассинхронились. Пяткой целят в твоё колено, а голов стало две, и обе смотрят в стороны.\")))",
      "key": "паттерн",
      "op": "set"
    },
    {
      "expr": "put(паттерн, \"страж огня\", list(list(\"голова\", \"корпус\", \"Страж бьёт факелом сверху и держит горнило груди закрытым.\"), list(\"голова\", \"корпус\", \"Второй такой же удар сверху. Горнило по-прежнему прикрыто.\"), list(\"корпус\", \"\", \"Он распахивает горнило, чтобы ударить всей грудью. Тяжело и открыто.\", 150)))",
      "key": "паттерн",
      "op": "set"
    },
    {
      "expr": "put(паттерн, \"страж воды\", list(list(\"корпус\", \"голова\", \"Вода собирается в таран напротив твоей груди, а над головой стража стоит купол.\"), list(\"ноги\", \"корпус\", \"Поток стелется по земле к твоим ногам, грудь закрыта стеной воды.\"), list(\"голова\", \"ноги\", \"Волна встаёт к твоему лицу, а ноги стража растеклись лужей — их не достать.\")))",
      "key": "паттерн",
      "op": "set"
    },
    {
      "expr": "put(паттерн, \"страж земли\", list(list(\"корпус\", \"ноги\", \"Каменный кулак идёт в грудь. Ноги стража вросли в породу.\"), list(\"голова\", \"ноги\", \"Кулак поднимается к голове. Ноги всё так же в породе.\"), list(\"\", \"ноги\", \"Страж врастает глубже и этот ход только стоит. Удара не будет, ноги в породе.\")))",
      "key": "паттерн",
      "op": "set"
    },
    {
      "expr": "put(паттерн, \"страж ветра\", list(list(\"ноги\", \"\", \"Ветер срывается низом, к твоим ногам. Закрываться страж не умеет вовсе.\"), list(\"голова\", \"\", \"Смерч поднимается к твоему лицу. Он снова открыт целиком.\"), list(\"корпус\", \"\", \"Воздух сжимается перед твоей грудью. Открыт, как и всегда.\")))",
      "key": "паттерн",
      "op": "set"
    },
    {
      "expr": "put(паттерн, \"меха-полковник\", list(list(\"корпус\", \"корпус\", \"Полковник упирает щиток в грудь и коротко бьёт в корпус.\"), list(\"голова\", \"корпус\", \"Щиток на месте, а плечевой манипулятор поднимается к твоей голове.\"), list(\"\", \"\", \"Гудит накопитель. Он не бьёт и не закрывается — вся броня отведена на заряд.\"), list(\"корпус\", \"голова\", \"Накопитель полон. Пушка идёт в грудь вдвое, кабину он прикрывает створкой.\", 200)))",
      "key": "паттерн",
      "op": "set"
    },
    {
      "expr": "put(паттерн, \"звёздный тиран\", list(list(\"\", \"\", \"Опись. Планета. Одна. Занята. Тиран поднимает руку и начинает замах. Он открыт весь и не бьёт.\"), list(\"\", \"\", \"Замах продолжается, свет вокруг него сгущается. Всё ещё открыт и всё ещё не бьёт.\"), list(\"голова\", \"\", \"Рука дошла до верхней точки. Сейчас он ударит сверху, по голове, и вдвое. Закрываться ему нечем.\", 200), list(\"корпус\", \"корпус\", \"После удара он собирается и коротко тычет в корпус, прикрывая грудь.\")))",
      "key": "паттерн",
      "op": "set"
    },
    {
      "expr": "put(паттерн, \"Нихарис\", list(list(\"\", \"голова\", \"Нихарис смотрит в сторону, будто ей скучно, и подпирает щёку ладонью.\"), list(\"голова\", \"голова\", \"Она наконец поворачивается к тебе и лениво тянет руку к твоему лбу. Ладонь всё ещё у лица.\", 150), list(\"корпус\", \"ноги\", \"Она делает шаг и опускает вторую руку к твоей груди. Подол закрывает ноги.\"), list(\"ноги\", \"\", \"Нихарис приседает к самой земле, к твоим ногам, и на этот миг не закрывает ничего.\", 150)))",
      "key": "паттерн",
      "op": "set"
    },
    {
