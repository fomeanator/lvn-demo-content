    {
      "expr": "репутация + 2",
      "key": "репутация",
      "op": "set"
    },
    {
      "expr": "put(память, \"гл2\", \"починил Ржавого\")",
      "key": "память",
      "op": "set"
    },
    {
      "expr": "push(летопись, \"собрал киберстража Ржавого из деталей\")",
      "key": "летопись",
      "op": "set"
    },
    {
      "label": "__wend_жила_4",
