      "key": "летопись",
      "op": "set"
    },
    {
      "label": "__wend_жила_8",
      "op": "goto"
    },
    {
      "id": "__wend_жила_8",
      "op": "label"
    },
    {
      "else": "__else_жила_1",
      "expr": "кристаллы \u003e= 1",
