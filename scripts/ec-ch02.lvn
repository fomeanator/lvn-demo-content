      "key": "летопись",
      "op": "set"
    },
    {
      "label": "__wend_жила_4",
      "op": "goto"
    },
    {
      "id": "__wend_жила_4",
      "op": "label"
    },
    {
      "op": "say",
      "text": "Наверх ты поднимаешься другим ходом — тем, где ступеньки."
    },
