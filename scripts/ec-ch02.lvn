      "op": "label"
    },
    {
      "else": "__else_zb_done_51",
      "expr": "бой_итог == \"выстоял\"",
      "op": "if",
      "then": "__then_zb_done_51"
    },
    {
      "id": "__then_zb_done_51",
      "op": "label"
    },
    {
      "expr": "1",
      "key": "бой_победа",
      "op": "set"
    },
    {
      "expr": "7",
      "key": "fp_distance",
      "op": "set"
    },
    {
      "expr": "\"idle\"",
      "key": "pose",
      "op": "set"
    },
    {
      "label": "__fn_ecfp_enemy",
      "op": "call"
    },
    {
      "op": "say",
      "text": "Вы оба выдохлись, но хуже ему. {бой_враг} отступает первым — у него {бой_хп} из {бой_хп0}."
    },
    {
      "label": "__end_zb_done_51",
      "op": "goto"
    },
    {
      "id": "__else_zb_done_51",
      "op": "label"
    },
    {
      "id": "__end_zb_done_51",
      "op": "label"
    },
    {
      "else": "__else_zb_done_52",
      "expr": "бой_итог == \"отступил\"",
      "op": "if",
      "then": "__then_zb_done_52"
    },
    {
      "id": "__then_zb_done_52",
      "op": "label"
    },
    {
      "expr": "6",
      "key": "fp_distance",
      "op": "set"
    },
    {
      "expr": "\"idle\"",
      "key": "pose",
      "op": "set"
    },
    {
      "label": "__fn_ecfp_enemy",
      "op": "call"
    },
    {
      "op": "say",
      "text": "Ты больше не держишь стойку и разрываешь дистанцию сам. Противнику осталось {бой_хп} из {бой_хп0} — ты его не добил."
    },
    {
      "label": "__end_zb_done_52",
