    },
    {
      "expr": "репутация + 2",
      "key": "репутация",
      "op": "set"
    },
    {
      "label": "__wend_жила_12",
      "op": "goto"
    },
    {
      "id": "__wend_жила_12",
      "op": "label"
    },
    {
      "op": "say",
      "text": "Дальше — тайга. Там холодно, а у холода расписание точнее моего.",
      "who": "Нихарис",
      "who_id": "ec_niharis"
    },
    {
      "else": "__nf_жила_13",
      "expr": "кнопка == 1",
