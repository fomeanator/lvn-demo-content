scene ec_chapter4

// ⚡ ELEMENTAL CHRONICLES — Глава 4: «Песок в шестерёнках»
//
// Пустыня и Долина гейзеров. Самая смешная глава арки: главный противник —
// не чудовище, а некромант-бюрократ Костолом, у которого на скелета Кнопку
// заведены документы.
//
// ЧИТАЕТ из прошлых глав:
//   кнопка   — 1, если Кнопка идёт с тобой (взят в главе 2)
//   меха     — "бур" | "резак" | "щит" (деталь меха из главы 2)
//   союзники, репутация, сумка кристаллов, стихии
// ОТДАЁТ дальше:
//   кнопка (окончательная судьба), союзник "Бурав", защита (0/1),
//   крупный сдвиг техногард, доверие (личный вопрос Нихарис №3),
//   летопись/память — их зачитают зеркало в главе 5 и финал в главе 6.
//
// Инициализации арочных переменных здесь НЕТ намеренно: незаданная переменная
// читается как 0/""/false, а push/put/len/has/get на ней работают корректно
// (CloneArr/CloneObj в LvnExpression.cs). Обнулять их в главе — значит стереть
// прогресс предыдущих глав: статы титула переживают смену главы.
include "ec-mechanics.lvns"
include "ec-preload.lvns"


m_scary   // мёртвый город
// Спрайты этих двоих лежат на диске, но в manifest.json → sprites записей пока
// нет. actor_map связывает табличку имени со слоем каста заранее: появятся
// записи — эмоции заработают без правки главы. До тех пор слой молча пропущен.
actor_map Костолом=ec_necromancer
actor_map Кнопка=ec_skeleton

// join — добавить союзника идемпотентно (второй раз не задваивается).
func join(who) { return concat(remove(союзники, who), list(who)) }

// pay — заплатить n кристаллов ЛЮБЫМИ, какие есть. Костолом не привередлив,
// червь тем более. Цикл всегда завершается: за проход либо гасится долг,
// либо из сумки уходит очередной ключ.
func pay(n) {
  долг = n
  while долг > 0 && gemsall() > 0 {
    монета = first(keys(сумка))
    взнос = min(gems(монета), долг)
    сумка = usegem(монета, взнос)
    долг = долг - взнос
    if gems(монета) == 0 { сумка = del(сумка, монета) } else { }
  }
}

hud «⚡{lvl()}   ♥{здоровье}/{maxhp()}   ◆{gemsall()}   друзей {len(союзники)}»

// ══════════════════════════════════════════════════════════════════════
//  1. ПУСТЫНЯ
// ══════════════════════════════════════════════════════════════════════
desert
«Пустыня начинается сразу за последним указателем. Указатель обещает воду
через двенадцать шагов и врёт примерно на два дня.
Песок тут мелкий и злой. К полудню он у тебя в сапогах, в волосах и,
кажется, уже в мыслях.»

if кнопка == 1 {
  skeleton left calm
  Кнопка [smile]: Хозя-а-аин. У меня песок в коленке. Она теперь поёт. Слушай — скрип-скрип. По-моему, ре-минор.
  «Скелет по имени Кнопка идёт за тобой третью главу и до сих пор не научился
  молчать. Ты почему-то этому рад.»
} else {
  «Идти одному тихо. Настолько тихо, что слышно, как ты думаешь, и мысли
  получаются мелкие. Где-то позади остался скелет, которого ты не взял.
  Пустыня об этом не напоминает — она вообще ни о чём не напоминает.»
}

niharis calm
Нихарис [smile]: Пустыня. Люблю — тут всё уже мёртвое, работать не надо. По записям у тебя, {имя}, ещё дня четыре. Не беги.
niharis hide

// ══════════════════════════════════════════════════════════════════════
//  2. УЗЕЛ A — КОСТОЛОМ И ОПИСЬ
// ══════════════════════════════════════════════════════════════════════
«Из-за бархана поднимается человек в мантии. В руке у него не посох.
В руке у него папка.»
necro angry
Костолом [calm]: Добрый день. Костолом, отдел учёта поднятого имущества. Не пугайтесь, я никого не поднимаю без основания — основание вот, в папке, двадцать четыре листа.

// Лучшая стихия против кости считается один раз: и скелет, и некромант —
// тьма, значит ответ на обоих один и тот же. "кулак" — страховка на случай,
// если стихий у игрока почему-то нет вовсе.
лучшая = "кулак"
for э in стихии {
  if hit(э, "некромант") > hit(лучшая, "некромант") { лучшая = э } else { }
}

if кнопка == 1 -> опись
-> повестка

// ─── A1. Кнопка с тобой — Костолом требует его назад ─────────────────
:опись
Кнопка [angry]: Он врёт! Я самоподнявшийся! Я сам поднялся, честное слово!
Костолом [calm]: Форма Н-13, графа «происхождение». Написано — поднят мною, Костоломом, в четверг. Четверг был, я проверял по календарю.
Костолом [smile]: Вариантов три, и все три законные. Я подчёркиваю — законные.

- Отдать Кнопку по описи {
  Ты расписываешься в трёх местах. Кнопка не спорит — раз бумага, значит,
  так надо. Он оборачивается один раз, потом идёт за мантией и больше
  не оборачивается.
  кнопка = 0
  союзники = remove(союзники, "Кнопка")
  репутация = репутация - 3
  летопись = push(летопись, "отдал Кнопку по описи")
  память = put(память, "гл4", "отдал")
}
- Выкупить его -> выкуп expr="gemsall() >= 3" cost="◆3"
- Драться за него -> драка cost="{odds(лучшая, \"некромант\")}"

