// ══════════════════════════════════════════════════════════════════════
//  ЛОКАЛЬНАЯ ФУНКЦИЯ ГЛАВЫ
//  Финальная мощь — буквально сумма пяти глав. Держим её здесь, а не в
//  общем файле: формула нужна ровно в этой главе и нигде больше.
//  Неиспользованная func не оставляет ни команды, так что цена нулевая.
// ══════════════════════════════════════════════════════════════════════
func ec6power() { return len(стихии) * 2 + len(союзники) * 3 + защита * 2 + урон_тирану + lvl() }
