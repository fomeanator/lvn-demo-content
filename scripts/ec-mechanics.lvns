// ⚡ ELEMENTAL CHRONICLES — общие механики
//
// Подключается каждой главой ПЕРВОЙ строкой после `scene`:
//     include "ec-mechanics.lvns"
//
// Здесь живут ТАБЛИЦЫ (данные), ФУНКЦИИ (чистые выражения) и ПРЕСЕТЫ (def).
// Правишь в одном месте — меняется во всех главах.
//
// Три правила этого файла:
//   1. Всё, что можно выразить таблицей put/get, выражено таблицей. Новый враг,
//      новое сочетание стихий, новый порог — ОДНА строка данных, а не ветвление.
//   2. Функции — только выражения (`return <одно выражение>`). Компилятор их
//      инлайнит, поэтому неиспользованная функция не оставляет в главе ни одной
//      команды и ни одного предупреждения. Процедур здесь нет НАМЕРЕННО:
//      неиспользованная процедура оставляет мёртвую метку и красит валидатор.
//   3. Имена функций и пресетов — латиницей (иначе компилятор их не увидит),
//      имена переменных — по-русски, их читают авторы глав.
//
// ══════════════════════════════════════════════════════════════════════
//  1. СОСТОЯНИЕ ИГРОКА
// ══════════════════════════════════════════════════════════════════════
// Переменные новеллы ПЕРЕЖИВАЮТ смену главы (движок сеет их из сохранённых
// статов титула). Поэтому обнулять их в каждой главе нельзя — иначе прогресс
// пяти глав сбрасывается на входе в шестую. Инициализация под стражем.
//
// ⚠ Пустой `else { }` внизу — НЕ мусор, не убирай. Блочный `if` без `else`
// оставляет метку конца, на которую никто не прыгает, и валидатор ругается.
// Это же правило действует в главах: `if … { … } else { … }`, и else пустой,
// если делать в нём нечего.

if игра_начата == 0 {
  имя = "Странник"
  фракция = "Никто"

  опыт = 0            // копится; уровень СЧИТАЕТСЯ из него функцией lvl()
  здоровье = 20       // текущее; потолок — maxhp(), он растёт с уровнем
  мощь = 2            // сила удара от оружия/тренировок (уровень добавляется сам)
  броня = 0           // вычитается из урона врага
  ходы = 0            // время меряется ходами: реального таймера в движке нет

  репутация = 0       // общая слава
  эфирия = 0          // репутация у Эфирии
  техногард = 0       // репутация у Техногарда

  стихии = []         // выученные стихии (список строк)
  сумка = {}          // ИНВЕНТАРЬ КРИСТАЛЛОВ: стихия -> сколько штук
  артефакты = []      // сюжетные предметы

  победы = 0
  поражения = 0

  // Устаревшее поле: его читает HUD пролога (ec-ch01). Настоящий инвентарь —
  // `сумка` + gemsall(). Новые главы `кристаллы` НЕ используют.
  кристаллы = 0

  игра_начата = 1
} else {
}

// ─── 1.1. ПАМЯТЬ АРКИ (главы 2–6) ─────────────────────────────────────
// Отдельный страж, а не общий: эти поля появились после того, как пролог уже
// ходил по рукам, и в старом сохранении `игра_начата` уже равна 1 — под общим
// стражем они остались бы неинициализированными. Читать неинициализированный
// список нельзя: len()/push() ждут список, а получат 0.
//
// ЭТО КОНТРАКТ МЕЖДУ ГЛАВАМИ. Инициализировать эти поля в самой главе НЕЛЬЗЯ —
// глава 3, обнулившая `летопись`, сотрёт то, что записала глава 2.
if память_арки == 0 {
  летопись = []       // «что ты сделал» — строка на каждый узел выбора;
                      // гл. 5 (зеркало) и гл. 6 (финальный рекап) её зачитывают
  союзники = []       // имена спутников: len() кормит финальную мощь
  память = {}         // "гл2" -> ключевое решение главы одной строкой
  доверие = 0         // 0–5: честные ответы на личный вопрос Нихарис (по 1 на главу)

  кнопка = 0          // скелет-спутник Кнопка идёт с тобой (1) или нет (0)
  меха = ""           // деталь меха из гл. 2: "бур" | "резак" | "щит"
  защита = 0          // 0/1 — паровая броня из гл. 4 (в формулах умножай: защита * 2)
  спасён_город = 0    // 0/1 — итог гл. 5
  урон_тирану = 0     // фора в финальном бою
  команда = ""        // "лес" | "сталь" | "своя" — с кем идёшь в гл. 6
  долг = 0            // невыплаченная пошлина; гасится в конце главы

  память_арки = 1
} else {
}

// ══════════════════════════════════════════════════════════════════════
//  2. ТАБЛИЦЫ (пересобираются каждой главой — правка таблицы сразу в игре)
// ══════════════════════════════════════════════════════════════════════

// ─── 2.1. Сила стихии в схватке ──────────────────────────────────────
сила = {}
сила = put(сила, "огонь", 3)
сила = put(сила, "вода", 2)
сила = put(сила, "земля", 4)
сила = put(сила, "ветер", 2)
сила = put(сила, "лёд", 3)
сила = put(сила, "молния", 5)
сила = put(сила, "тьма", 4)
сила = put(сила, "свет", 4)
сила = put(сила, "природа", 3)
сила = put(сила, "кислота", 4)
сила = put(сила, "хаос", 5)
сила = put(сила, "эфир", 6)
сила = put(сила, "космос", 7)
// «кулак» — это НЕ стихия, а страховка: чем бьёт герой, у которого стихий
// ещё нет вовсе. Сила 1 = ровно то, что раньше давал get(…, 1) по умолчанию,
// поэтому строка ничего не меняет в старых формулах — она только делает
// страховку видимой (её уже пишет гл. 4 и зонный бой).
сила = put(сила, "кулак", 1)
// составные (результаты сочетаний) — заведомо сильнее базовых
сила = put(сила, "магма", 7)
сила = put(сила, "плазма", 8)
сила = put(сила, "кристалл", 6)
сила = put(сила, "пар", 5)
сила = put(сила, "туман", 4)
сила = put(сила, "разряд", 6)
сила = put(сила, "буря пепла", 6)
сила = put(сила, "песчаный вихрь", 6)
сила = put(сила, "сумерки", 7)
сила = put(сила, "грязь", 5)
сила = put(сила, "паровой взрыв", 7)
сила = put(сила, "сверхпроводник", 8)
сила = put(сила, "гроза", 7)
сила = put(сила, "радуга", 6)
сила = put(сила, "обсидиан", 7)
сила = put(сила, "сияющий вихрь", 7)
сила = put(сила, "адский пепел", 7)
сила = put(сила, "трясина", 6)
сила = put(сила, "друза", 6)
сила = put(сила, "тень бури", 7)
сила = put(сила, "вечная мерзлота", 7)
сила = put(сила, "метель", 6)
сила = put(сила, "призма", 7)
сила = put(сила, "чёрный лёд", 7)

// ─── 2.2. Сочетания стихий ───────────────────────────────────────────
// Порядок в ключе не важен: fuse() пробует обе стороны.
рецепты = {}
рецепты = put(рецепты, "огонь+земля", "магма")
рецепты = put(рецепты, "огонь+вода", "пар")
рецепты = put(рецепты, "огонь+ветер", "буря пепла")
рецепты = put(рецепты, "огонь+молния", "плазма")
рецепты = put(рецепты, "огонь+лёд", "паровой взрыв")
рецепты = put(рецепты, "огонь+тьма", "адский пепел")
рецепты = put(рецепты, "вода+ветер", "туман")
рецепты = put(рецепты, "вода+молния", "разряд")
рецепты = put(рецепты, "вода+земля", "грязь")
рецепты = put(рецепты, "вода+свет", "радуга")
рецепты = put(рецепты, "вода+тьма", "трясина")
рецепты = put(рецепты, "земля+ветер", "песчаный вихрь")
рецепты = put(рецепты, "земля+молния", "кристалл")
рецепты = put(рецепты, "земля+свет", "друза")
рецепты = put(рецепты, "земля+тьма", "обсидиан")
рецепты = put(рецепты, "ветер+молния", "гроза")
рецепты = put(рецепты, "ветер+свет", "сияющий вихрь")
рецепты = put(рецепты, "ветер+тьма", "тень бури")
рецепты = put(рецепты, "лёд+молния", "сверхпроводник")
рецепты = put(рецепты, "лёд+земля", "вечная мерзлота")
рецепты = put(рецепты, "лёд+ветер", "метель")
рецепты = put(рецепты, "лёд+свет", "призма")
рецепты = put(рецепты, "лёд+тьма", "чёрный лёд")
рецепты = put(рецепты, "тьма+свет", "сумерки")
// Двухступенчатый крафт: тьма+свет -> сумерки, огонь+молния -> плазма,
// а сумерки+плазма -> эфир. Эфир и сумерки — единственные ответы на космос,
// то есть на Нихарис. Без сварки финального босса не взять.
рецепты = put(рецепты, "сумерки+плазма", "эфир")
рецепты = put(рецепты, "свет+молния", "эфир")

// ─── 2.3. Преимущество стихий (в ПРОЦЕНТАХ урона) ────────────────────
// Ключ "чем_бьёшь>чем_защищаются". 100 — обычный урон, 200 — вдвое,
// 50 — вполовину. Нуля здесь нет специально: полная неуязвимость делает
// бой тупиком, из которого автор главы не выберется.
преимущество = {}
преимущество = put(преимущество, "вода>огонь", 200)
преимущество = put(преимущество, "огонь>лёд", 200)
преимущество = put(преимущество, "огонь>природа", 200)
преимущество = put(преимущество, "молния>вода", 200)
преимущество = put(преимущество, "земля>молния", 200)
преимущество = put(преимущество, "ветер>земля", 200)
преимущество = put(преимущество, "лёд>вода", 150)
преимущество = put(преимущество, "свет>тьма", 200)
преимущество = put(преимущество, "тьма>свет", 200)
преимущество = put(преимущество, "кислота>металл", 200)
преимущество = put(преимущество, "магма>лёд", 200)
преимущество = put(преимущество, "плазма>тьма", 200)
преимущество = put(преимущество, "сверхпроводник>лёд", 200)
преимущество = put(преимущество, "сумерки>хаос", 200)
// У КАЖДОГО врага должен быть ответ. Эти строки закрывают стихии, против
// которых иначе не нашлось бы ничего: кристалл, ветер, хаос, космос.
преимущество = put(преимущество, "магма>кристалл", 200)
преимущество = put(преимущество, "гроза>ветер", 200)
преимущество = put(преимущество, "молния>ветер", 150)
преимущество = put(преимущество, "свет>хаос", 150)
преимущество = put(преимущество, "хаос>космос", 200)
преимущество = put(преимущество, "эфир>космос", 200)
преимущество = put(преимущество, "сумерки>космос", 200)
преимущество = put(преимущество, "сумерки>свет", 150)
преимущество = put(преимущество, "песчаный вихрь>земля", 200)
преимущество = put(преимущество, "пар>огонь", 150)
преимущество = put(преимущество, "разряд>вода", 200)
// обратная сторона тех же пар — бьёшь слабо
преимущество = put(преимущество, "огонь>вода", 50)
преимущество = put(преимущество, "лёд>огонь", 50)
преимущество = put(преимущество, "вода>молния", 50)
преимущество = put(преимущество, "молния>земля", 50)
преимущество = put(преимущество, "земля>ветер", 50)
преимущество = put(преимущество, "тьма>тьма", 50)
преимущество = put(преимущество, "свет>свет", 50)
// стихия сопротивляется самой себе
преимущество = put(преимущество, "огонь>огонь", 50)
преимущество = put(преимущество, "вода>вода", 50)
преимущество = put(преимущество, "земля>земля", 50)
преимущество = put(преимущество, "ветер>ветер", 50)
преимущество = put(преимущество, "лёд>лёд", 50)
преимущество = put(преимущество, "молния>молния", 50)

// ─── 2.4. Враги: три параллельные таблицы ────────────────────────────
// Новый враг = три строки. Опыт и трофей выводятся из этих чисел функциями,
// поэтому четвёртой таблицы нет.
враг_хп = {}
враг_хп = put(враг_хп, "скелет", 12)
враг_хп = put(враг_хп, "дрон", 15)
// Костолом и Ржавый — названные персонажи глав 2/4/5/6. До зонного боя они
// существовали только репликами; теперь у них есть числа и паттерн, потому
// что с ними можно схватиться (с Ржавым — на спарринге, он свой).
враг_хп = put(враг_хп, "Костолом", 20)
враг_хп = put(враг_хп, "Ржавый", 26)
враг_хп = put(враг_хп, "матёрый скелет", 30)
враг_хп = put(враг_хп, "глитч", 34)
враг_хп = put(враг_хп, "некромант", 38)
враг_хп = put(враг_хп, "кристальный паук", 48)
враг_хп = put(враг_хп, "песчаный червь", 55)
враг_хп = put(враг_хп, "меха-полковник", 60)
враг_хп = put(враг_хп, "ледяной великан", 75)
враг_хп = put(враг_хп, "страж ветра", 80)
враг_хп = put(враг_хп, "страж огня", 90)
враг_хп = put(враг_хп, "страж воды", 90)
враг_хп = put(враг_хп, "страж земли", 95)
враг_хп = put(враг_хп, "звёздный тиран", 150)
враг_хп = put(враг_хп, "Нихарис", 200)

враг_стихия = {}
враг_стихия = put(враг_стихия, "скелет", "тьма")
враг_стихия = put(враг_стихия, "Костолом", "тьма")
враг_стихия = put(враг_стихия, "Ржавый", "молния")
враг_стихия = put(враг_стихия, "матёрый скелет", "тьма")
враг_стихия = put(враг_стихия, "дрон", "молния")
враг_стихия = put(враг_стихия, "глитч", "хаос")
враг_стихия = put(враг_стихия, "некромант", "тьма")
враг_стихия = put(враг_стихия, "кристальный паук", "кристалл")
враг_стихия = put(враг_стихия, "песчаный червь", "земля")
враг_стихия = put(враг_стихия, "меха-полковник", "молния")
враг_стихия = put(враг_стихия, "ледяной великан", "лёд")
враг_стихия = put(враг_стихия, "страж ветра", "ветер")
враг_стихия = put(враг_стихия, "страж огня", "огонь")
враг_стихия = put(враг_стихия, "страж воды", "вода")
враг_стихия = put(враг_стихия, "страж земли", "земля")
враг_стихия = put(враг_стихия, "звёздный тиран", "свет")
враг_стихия = put(враг_стихия, "Нихарис", "космос")

враг_урон = {}
враг_урон = put(враг_урон, "скелет", 3)
враг_урон = put(враг_урон, "Костолом", 6)
враг_урон = put(враг_урон, "Ржавый", 5)
враг_урон = put(враг_урон, "дрон", 4)
враг_урон = put(враг_урон, "матёрый скелет", 6)
враг_урон = put(враг_урон, "глитч", 7)
враг_урон = put(враг_урон, "некромант", 8)
враг_урон = put(враг_урон, "кристальный паук", 9)
враг_урон = put(враг_урон, "песчаный червь", 10)
враг_урон = put(враг_урон, "меха-полковник", 11)
враг_урон = put(враг_урон, "ледяной великан", 12)
враг_урон = put(враг_урон, "страж ветра", 13)
враг_урон = put(враг_урон, "страж воды", 13)
враг_урон = put(враг_урон, "страж огня", 14)
враг_урон = put(враг_урон, "страж земли", 14)
враг_урон = put(враг_урон, "звёздный тиран", 18)
враг_урон = put(враг_урон, "Нихарис", 20)

// ─── 2.4a. Две колонки для ЗОННОГО боя (ec-battle.lvns) ──────────────
// Обе НЕОБЯЗАТЕЛЬНЫЕ: врага, которого здесь нет, бой всё равно проведёт по
// умолчанию (не уклоняется, отваливает как все). Поэтому новый враг — по-прежнему
// ТРИ строки в таблицы выше, а эти две — только если он особенный.
//
// Уклонение: сколько ПРОЦЕНТОВ урона уходит вскользь, когда ты бьёшь в
// КОРПУС — увёртливого в туловище чисто не берут. Не кубик: в зонном бою
// нет ни одного rand(), иначе защита превращается в угадывание. Попадание
// ПО НОГАМ обнуляет уклонение до конца схватки — в этом смысл зоны «ноги».
враг_уклон = {}
враг_уклон = put(враг_уклон, "дрон", 15)
враг_уклон = put(враг_уклон, "глитч", 25)
враг_уклон = put(враг_уклон, "кристальный паук", 20)
враг_уклон = put(враг_уклон, "страж ветра", 30)
враг_уклон = put(враг_уклон, "звёздный тиран", 20)

// Трусость: при каком ПРОЦЕНТЕ своего здоровья враг разрывает дистанцию и
// уходит. Тоже без кубика — порог, а не шанс. По умолчанию 40, то есть
// бегут ВСЕ, кроме тех, кому здесь прописан ноль. Перебитые ноги отменяют
// побег: подрубил ноги — доведёшь схватку до конца.
враг_трус = {}
враг_трус = put(враг_трус, "скелет", 0)          // костям бежать нечем
враг_трус = put(враг_трус, "Костолом", 0)        // он не бежит, он оформляет
враг_трус = put(враг_трус, "матёрый скелет", 0)
враг_трус = put(враг_трус, "песчаный червь", 0)
враг_трус = put(враг_трус, "страж огня", 0)      // стражи стоят насмерть
враг_трус = put(враг_трус, "страж воды", 0)
враг_трус = put(враг_трус, "страж земли", 0)
враг_трус = put(враг_трус, "страж ветра", 0)
враг_трус = put(враг_трус, "звёздный тиран", 0)
враг_трус = put(враг_трус, "Нихарис", 0)

// ─── 2.5. Прогрессия ─────────────────────────────────────────────────
// НАКОПЛЕННЫЙ опыт, при котором открывается следующий уровень.
// Уровень не хранится — он ВЫЧИСЛЯЕТСЯ из опыта функцией lvl(), поэтому
// «повысить уровень» нельзя забыть: дал опыт — уровень поднялся сам.
// ВАЖНО: в lvl() ровно столько слагаемых step(i), сколько здесь порогов.
пороги = list(10, 25, 45, 70, 100, 140)

// Титул по уровню (индекс = уровень - 1).
титулы = list("Новичок", "Искатель", "Стихийник", "Мастер стихий", "Архимаг", "Легенда Эфирии", "Тот, кого помнит Нихарис")

// ─── 2.6. Пороги проверок ────────────────────────────────────────────
// «Порог проверки» — сколько надо набрать, чтобы затея удалась.
// Проверка = ставка (стат) + уровень против порога: score(стат) >= hard().
сложность = {}
сложность = put(сложность, "легко", 4)
сложность = put(сложность, "обычно", 8)
сложность = put(сложность, "трудно", 12)
сложность = put(сложность, "почти невозможно", 16)

// ─── 2.7. Репутация ──────────────────────────────────────────────────
// Ранг = слово вместо числа: rank(эфирия) -> "Союзник".
ранги = list("Чужак", "Знакомый", "Союзник", "Друг", "Герой", "Легенда")

// Пороги концовок (Акт 4 документа). Условие концовки — ОДНА строка данных.
финалы = {}
финалы = put(финалы, "единство", 12)      // unity() — нужен обеим фракциям
финалы = put(финалы, "лес", 10)           // эфирия
финалы = put(финалы, "сталь", 10)         // техногард
финалы = put(финалы, "одиночка", 14)      // репутация без фракции
финалы = put(финалы, "тиран", 18)         // репутация для боя со Звёздным тираном

// ─── 2.8. Цены в кристаллах ──────────────────────────────────────────
цена = {}
цена = put(цена, "стихия", 3)     // выучить новую стихию
цена = put(цена, "оружие", 4)     // +1 к мощи
цена = put(цена, "броня", 4)      // +1 к броне
цена = put(цена, "зелье", 2)      // лечение
цена = put(цена, "цепь", 5)       // модуль цепи из документа
цена = put(цена, "мех", 12)       // деталь меха

// ══════════════════════════════════════════════════════════════════════
//  3. ФУНКЦИИ (латиницей; инлайнятся — работают и в тексте, и в expr= выбора)
// ══════════════════════════════════════════════════════════════════════

// ─── 3.1. Уровень и опыт ─────────────────────────────────────────────
// step(i) даёт 1, когда опыт перевалил i-й порог, иначе 0. Порога нет в
// таблице -> 99999 -> слагаемое 0. max(...,1) — страховка от деления на ноль:
// оно в движке БРОСАЕТ ошибку, а не возвращает 0.
func step(i) { return min(floor(опыт / max(get(пороги, i, 99999), 1)), 1) }
func lvl() { return 1 + step(0) + step(1) + step(2) + step(3) + step(4) + step(5) }
func maxlvl() { return len(пороги) + 1 }
func nextxp() { return get(пороги, lvl() - 1, 0) }        // 0 = потолок взят
func maxed() { return nextxp() == 0 }
func title() { return get(титулы, lvl() - 1, "Легенда") }

// ─── 3.2. Здоровье ───────────────────────────────────────────────────
func maxhp() { return 20 + (lvl() - 1) * 6 }
func alive() { return здоровье > 0 }
func hurt(n) { return max(здоровье - n, 0) }              // здоровье = hurt(5)
func heal(n) { return min(здоровье + n, maxhp()) }        // здоровье = heal(6)
func hppct() { return floor(здоровье * 100 / max(maxhp(), 1)) }

// ─── 3.3. Стихии и сочетания ─────────────────────────────────────────
func elpow(e) { return get(сила, e, 1) }
func knows(e) { return has(стихии, e) }
func learn(e) { return concat(remove(стихии, e), list(e)) }   // стихии = learn("огонь")
func fuse(a, b) { return get(рецепты, a + "+" + b, get(рецепты, b + "+" + a, "")) }
func canfuse(a, b) { return fuse(a, b) != "" }
func power(a, b) { return elpow(a) + elpow(b) }           // старое имя, оставлено для пролога

// ─── 3.4. Боевая формула ─────────────────────────────────────────────
// Урон = (сила стихии + мощь + уровень) * преимущество / 100, но не меньше 1.
func advantage(a, b) { return get(преимущество, a + ">" + b, 100) }
func atk(a, b) { return max(floor((elpow(a) + мощь + lvl()) * advantage(a, b) / 100), 1) }

func foehp(f) { return get(враг_хп, f, 10) }
func foeel(f) { return get(враг_стихия, f, "земля") }
func foedmg(f) { return max(get(враг_урон, f, 3) - броня, 1) }

func hit(a, f) { return atk(a, foeel(f)) }                       // урон стихией a по врагу f
func rounds(a, f) { return floor((foehp(f) - 1) / hit(a, f)) + 1 }  // ходов на убийство (ceil без ceil)
func endure(f) { return floor((здоровье - 1) / foedmg(f)) + 1 }     // сколько ходов ты выстоишь
func beats(a, f) { return rounds(a, f) <= endure(f) }               // победишь ли
func toll(a, f) { return max(min((rounds(a, f) - 1) * foedmg(f), здоровье - 1), 0) }  // сколько НР стоит победа
func reward(f) { return floor(foehp(f) / 8) + get(враг_урон, f, 3) }          // опыт за победу
func drop(f) { return foeel(f) }                                    // кристалл, который падает
// Словами для подписи под опцией: cost="{odds(\"огонь\", \"скелет\")}"
func odds(a, f) { return get(list("безнадёжно", "рискованно", "ровно", "уверенно", "легко"), min(max(floor((endure(f) - rounds(a, f)) / 2) + 1, 0), 4), "ровно") }

// ─── 3.5. Кристаллы (инвентарь) ──────────────────────────────────────
func gems(e) { return get(сумка, e, 0) }
func gemsall() { return sum(vals(сумка)) }
func addgem(e, n) { return put(сумка, e, gems(e) + n) }   // сумка = addgem("огонь", 2)
func usegem(e, n) { return put(сумка, e, max(gems(e) - n, 0)) }
func price(x) { return get(цена, x, 3) }
func afford(e, x) { return gems(e) >= price(x) }          // хватает ли кристаллов стихии e на x

// ─── 3.6. Проверки (порог) ───────────────────────────────────────────
func easy() { return get(сложность, "легко", 4) }
func normal() { return get(сложность, "обычно", 8) }
func hard() { return get(сложность, "трудно", 12) }
func brutal() { return get(сложность, "почти невозможно", 16) }
func score(s) { return s + lvl() }                        // ставка + уровень
func edge(s, d) { return score(s) - d }                   // запас: >=0 прошёл
func roll(s, d) { return score(s) + rand(1, 6) >= d }     // с кубиком; НЕ ставить в expr= опции
func threshold(lv) { return 4 + lv * 3 }                  // старая формула, оставлена для пролога

// ─── 3.7. Фракции и репутация ────────────────────────────────────────
func rank(r) { return get(ранги, min(max(floor(r / 4), 0), len(ранги) - 1), "Легенда") }
// Кто тебе ближе. Никакого ветвления: индекс -1/0/+1 сдвинут в 0..2.
func ally() { return get(list("Техногард", "Равновесие", "Эфирия"), min(max(эфирия - техногард, -1), 1) + 1, "Никто") }
func unity() { return min(эфирия, техногард) }            // «истинное единство» — обеим сразу
func rift() { return abs(эфирия - техногард) }            // насколько ты перекошен
func goal(name) { return get(финалы, name, 10) }          // порог концовки

// ══════════════════════════════════════════════════════════════════════
//  4. ПРЕСЕТЫ ПОСТАНОВКИ (def — чистые макросы, в рантайм не попадают)
// ══════════════════════════════════════════════════════════════════════

// ─── 4.1. Актёры ─────────────────────────────────────────────────────
def niharis actor ec_niharis center
def druid actor ec_druid left
def techno actor ec_techno right
// ⚠ НЕ ИСПОЛЬЗУЙ ПЯТЬ ПРЕСЕТОВ НИЖЕ, пока кто-нибудь не заведёт этих героев в
// manifest.json -> sprites. Картинки на диске лежат (server/content/sprites/
// ec_skeleton и т.д.), но в каталоге каста их нет, поэтому на сцене будет
// пусто, а табличка с именем — пустая. Ошибки при этом НЕ будет: незагруженный
// слой молча пропускается, и баг заметят только глазами.
// Пока в игре три живых актёра: niharis, druid, techno.
def skeleton actor ec_skeleton center angry
def necro actor ec_necromancer right angry
def spirit actor ec_spirit left calm
def tyrant actor ec_tyrant center angry
def cyber actor ec_cyberguard right calm

// ─── 4.2. Фоны (все 15 из server/content/bg/ec) ──────────────────────
def village bg /content/bg/ec/village.jpg
def efiria bg /content/bg/ec/efiria.jpg
def technogard bg /content/bg/ec/technogard.jpg
def shining bg /content/bg/ec/shining_zone.jpg
def moon bg /content/bg/ec/moon.jpg
def abyss bg /content/bg/ec/abyss.jpg
def taiga bg /content/bg/ec/taiga.jpg
def arctic bg /content/bg/ec/arctic.jpg
def desert bg /content/bg/ec/desert.jpg
def geysers bg /content/bg/ec/geysers.jpg
def glasswaste bg /content/bg/ec/glass_waste.jpg
def deadcity bg /content/bg/ec/dead_city.jpg
def catacombs bg /content/bg/ec/crystal_catacombs.jpg
def spiritforest bg /content/bg/ec/spirit_forest.jpg
def firetemple bg /content/bg/ec/temple_fire.jpg
def workshop bg /content/bg/ec/techno_workshop.jpg
def roadnorth bg /content/bg/ec/road_north.jpg
def orbit bg /content/bg/ec/orbit.jpg

// ─── Музыка ──────────────────────────────────────────────────────────
// Пресет = одно слово в главе. Трек играет в канале music и зациклен,
// поэтому смена сцены не обрывает его на полуслове.
def m_hope audio channel=music action=play url=/content/audio/music/hope.mp3 loop=true
def m_winter audio channel=music action=play url=/content/audio/music/frozen_winter.mp3 loop=true
def m_scary audio channel=music action=play url=/content/audio/music/woo_scary.mp3 loop=true
def m_feast audio channel=music action=play url=/content/audio/music/beanfeast.mp3 loop=true
def m_drama audio channel=music action=play url=/content/audio/music/dramatic_boi.mp3 loop=true
def m_drama2 audio channel=music action=play url=/content/audio/music/dramatic_boi_v3.mp3 loop=true
def m_boss audio channel=music action=play url=/content/audio/music/dramatic_boi_v5.mp3 loop=true
def m_stop audio channel=music action=stop fade=1.0

// ─── 4.3. Эффекты ────────────────────────────────────────────────────
def dark fade to="black" duration=0.8
def light fade to="clear" duration=0.8
def boom camera action=shake amplitude=0.045 duration=0.45
def zoomin camera action=zoom factor=1.15 duration=0.6
def zoomout camera action=reset duration=0.5
def blink flash color="white" duration=0.25
def hurtfx flash color="#ff3b30" duration=0.3
def winfx flash color="#ffd76a" duration=0.35
def snowon particles type=snow on=true
def snowoff particles type=snow on=false
def rainon particles type=rain on=true
def rainoff particles type=rain on=false

// ─── 4.4. HUD ────────────────────────────────────────────────────────
def hud text hud x=3 y=5 size=34 color=#ffd76a
def hudon text hud x=3 y=5 size=28 color=#ffd76a «⚡ Ур.{lvl()} {title()}   |   ♥️ {здоровье}/{maxhp()}   |   💎 Кристаллы: {gemsall()}   |   🏆 Репутация: {репутация}»
def hudoff text hud hide
def levelup hint text="⬆ Новый уровень: {lvl()} — {title()}" duration=3

// ─── 4.5. Короткие ходы ──────────────────────────────────────────────
def tick ходы = ходы + 1
def rest здоровье = maxhp()

// ══════════════════════════════════════════════════════════════════════
//  5. ШПАРГАЛКА ДЛЯ АВТОРА ГЛАВЫ (копируй и правь)
// ══════════════════════════════════════════════════════════════════════
//
// ⚠ ГРАБЛЯ 1: блочный `if` ВСЕГДА пишется с `else`, даже пустым.
//   `if c { … }`            -> 1 предупреждение (мёртвая метка конца)
//   `if c { … } else { }`   -> 0 предупреждений
//   `if c -> метка`         -> 0 предупреждений
//
// ⚠ ГРАБЛЯ 2: ДВОЕТОЧИЕ В ОДНОСТРОЧНОЙ НАРРАЦИИ ДЕЛАЕТ ИЗ НЕЁ РЕПЛИКУ.
//   Валидатор молчит, а в игре появляется табличка с именем говорящего.
//     Ранг у Эфирии: {rank(эфирия)}.  -> табличка с именем "Ранг у Эфирии"
//     ёлочки КОНЦОВКА: КОРНИ. ёлочки  -> имя "ёлочка + КОНЦОВКА", это не шутка
//   Пиши тире:  Ранг у Эфирии — {rank(эфирия)}.
//   Либо разложи ёлочки на ДВЕ строки: многострочный текст двоеточия не боится.
//
// ⚠ ГРАБЛЯ 3: булево в тексте печатается как «true»/«false».
//   Не {afford("огонь","броня")}, а `if afford(…) { … } else { … }`.
//
// НАЧАЛО ГЛАВЫ
//   scene ec_ch02
//   include "ec-mechanics.lvns"
//   hudon
//   efiria
//
// ОПЫТ И УРОВЕНЬ (уровень поднимается сам — его не надо присваивать)
//   ранее = lvl()
//   опыт = опыт + 12
//   if lvl() > ранее { levelup } else { }
//
// БОЙ ЧЕРЕЗ ВЫБОР (подпись показывает шансы, expr прячет то, чего нет)
//   - Ударить огнём -> бой_огонь cost="{odds(\"огонь\", \"скелет\")}" expr="knows(\"огонь\")"
//   - Отступить {
//     Ты пятишься. Скелет не преследует.
//     поражения = поражения + 1
//   }
//   Дальше идём вместе.
//
//   -> бой_огонь
//   :бой_огонь
//   if beats("огонь", "скелет") {
//     здоровье = hurt(toll("огонь", "скелет"))
//     опыт = опыт + reward("скелет")
//     сумка = addgem(drop("скелет"), 1)
//     победы = победы + 1
//     winfx
//     «Ты сжёг его за {rounds("огонь", "скелет")} удара. Урон за удар — {hit("огонь", "скелет")}.»
//   } else {
//     hurtfx
//     здоровье = hurt(foedmg("скелет") * 2)
//     поражения = поражения + 1
//     «Не хватило. Скелет достал тебя дважды.»
//   }
//
// ЛУЧШАЯ СТИХИЯ ПРОТИВ ВРАГА (цикл, потому что выражение не умеет перебирать)
//   лучшая = first(стихии)
//   for э in стихии {
//     if hit(э, "ледяной великан") > hit(лучшая, "ледяной великан") { лучшая = э } else { }
//   }
//
// СОЧЕТАНИЕ СТИХИЙ
//   итог = fuse("огонь", "земля")
//   if итог != "" {
//     стихии = learn(итог)
//     «Слилось: {итог}. Сила {elpow(итог)}.»
//   } else {
//     «Стихии зашипели и разошлись.»
//   }
//
// ПРОВЕРКА ПО ПОРОГУ
//   - Взломать дверь -> взлом expr="score(мощь) >= hard()"
//   - Уговорить стража -> уговор expr="score(эфирия) >= normal()"
//   if roll(репутация, hard()) { «Прокатило.» } else { «Не поверили.» }
//   (roll() кидает кубик — в expr= опции его НЕ ставь: список опций
//    пересчитывается, и вариант будет мигать. В expr= только score()/knows()/afford().)
//
// ПОКУПКА ЗА КРИСТАЛЛЫ
//   - Купить броню -> купить expr="afford(\"земля\", \"броня\")"
//   :купить
//   сумка = usegem("земля", price("броня"))
//   броня = броня + 1
//
// КОНЦОВКИ
//   if unity() >= goal("единство") -> концовка_единство
//   if эфирия >= goal("лес") -> концовка_лес
//   if техногард >= goal("сталь") -> концовка_сталь
//   -> концовка_одиночка
